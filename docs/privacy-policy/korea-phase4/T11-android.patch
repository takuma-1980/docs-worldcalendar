+package xyz.takuborn.worldcalendar.core.ui
+
+import java.time.LocalDate
+import java.time.format.DateTimeFormatter
+import java.util.Locale
+
+// Presentation only: do not convert time zones or reinterpret calendar dates here.
+internal fun formatDisplayTime24(hour: Int, minute: Int): String {
+    if (hour !in 0..23 || minute !in 0..59) return "--:--"
+    return "${hour.toString().padStart(2, '0')}:${minute.toString().padStart(2, '0')}"
+}
+
+internal fun formatGregorianDateForDisplay(date: LocalDate, locale: Locale): String =
+    date.format(DateTimeFormatter.ofPattern(
+        if (locale.language == "ko") "yyyy년 M월 d일" else "yyyy/MM/dd", locale
+    ))
--- a/app/src/test/java/xyz/takuborn/worldcalendar/core/ui/DisplayDateTimeFormatterTest.kt
+++ b/app/src/test/java/xyz/takuborn/worldcalendar/core/ui/DisplayDateTimeFormatterTest.kt
@@ -0,0 +1,30 @@
+package xyz.takuborn.worldcalendar.core.ui
+
+import com.google.common.truth.Truth.assertThat
+import java.time.LocalDate
+import java.util.Locale
+import org.junit.Test
+
+class DisplayDateTimeFormatterTest {
+    @Test fun `midnight noon and minute padding use consistent 24 hour labels`() {
+        assertThat(formatDisplayTime24(0, 0)).isEqualTo("00:00")
+        assertThat(formatDisplayTime24(12, 0)).isEqualTo("12:00")
+        assertThat(formatDisplayTime24(23, 5)).isEqualTo("23:05")
+    }
+    @Test fun `invalid editing values have a safe placeholder`() {
+        assertThat(formatDisplayTime24(24, 0)).isEqualTo("--:--")
+        assertThat(formatDisplayTime24(12, 60)).isEqualTo("--:--")
+    }
+    @Test fun `Korean dates preserve year end and leap day without time zone conversion`() {
+        assertThat(formatGregorianDateForDisplay(LocalDate.of(2026, 12, 31), Locale.KOREA))
+            .isEqualTo("2026년 12월 31일")
+        assertThat(formatGregorianDateForDisplay(LocalDate.of(2024, 2, 29), Locale.KOREAN))
+            .isEqualTo("2024년 2월 29일")
+    }
+    @Test fun `Japanese and English recurrence dates preserve existing format`() {
+        for (locale in listOf(Locale.JAPAN, Locale.US)) {
+            assertThat(formatGregorianDateForDisplay(LocalDate.of(2026, 1, 1), locale))
+                .isEqualTo("2026/01/01")
+        }
+    }
+}
